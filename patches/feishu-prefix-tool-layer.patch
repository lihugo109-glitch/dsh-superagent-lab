diff --git a/tests/feishu-channel.spec.ts b/tests/feishu-channel.spec.ts
new file mode 100644
index 0000000..e80162e
--- /dev/null
+++ b/tests/feishu-channel.spec.ts
@@ -0,0 +1,35 @@
+/** The Feishu Channel renders the speaker a message carries at delivery: once, never doubled, never counting toward the IM limit. */
+import { expect, it, vi } from 'vitest'
+import type { OutboundMessage } from '../src/core/index.ts'
+import { Commands } from '../src/infra/commands.ts'
+import { sendFeishu } from '../src/sources/feishu-channel.ts'
+import { feishuChannel } from '../src/sources/feishu-trigger.ts'
+import { testDeployment } from './fixtures/deployment.ts'
+
+const channel = feishuChannel('oc_team', 'om_1')
+/** Sends one message through the Feishu Channel and returns the Markdown the bot CLI was given plus every argument. */
+async function send(text: string, speaker?: string) {
+  const commands = new Commands(() => testDeployment(), {}, new AbortController().signal)
+  const run = vi.spyOn(commands, 'run').mockResolvedValue('{"ok":true,"data":{}}')
+  const message: OutboundMessage = { id: 'reply-1', channel, text, kind: 'reply', ...speaker ? { speaker } : {} }
+  await sendFeishu({ commands }, message)
+  const args = run.mock.calls[0]![1]
+  return { args, markdown: args[args.indexOf('--markdown') + 1]! }
+}
+
+it('prefixes a message with its speaker at delivery', async () => {
+  expect((await send('Done', 'fix-plan-color')).markdown).toBe('[fix-plan-color] Done')
+})
+
+it('leaves a message without a speaker unprefixed', async () => {
+  expect((await send('Done')).markdown).toBe('Done')
+})
+
+it('does not double a prefix the message already carries', async () => {
+  expect((await send('[fix-plan-color] Done', 'fix-plan-color')).markdown).toBe('[fix-plan-color] Done')
+})
+
+it('counts only the message toward the IM word limit, not the prefix', async () => {
+  const text = Array.from({ length: 100 }, (_, index) => `word${index}`).join(' ')
+  expect((await send(text, 'a-very-long-ticket-name')).markdown).toBe(`[a-very-long-ticket-name] ${text}`)
+})
